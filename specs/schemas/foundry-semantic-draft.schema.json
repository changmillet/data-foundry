{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.local/foundry/semantic-draft.schema.json",
  "title": "Foundry semantic preparation draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "submissions"],
  "properties": {
    "schema": {
      "const": "tiangong-foundry.semantic-draft.v1"
    },
    "submissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "authoring_task", "file"],
        "properties": {
          "kind": {
            "enum": ["patch", "classification", "location", "identity"]
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000\\r\\n]+$"
          },
          "decision_ids": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            }
          },
          "authoring_task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000\\r\\n]+$"
          }
        }
      }
    }
  }
}

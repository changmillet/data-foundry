{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true,
    "inlineSources": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts",
    "src/**/*.cts",
    "devops/**/*.ts",
    "devops/**/*.mts",
    "devops/**/*.cts"
  ],
  "exclude": ["test", "node_modules", "dist", ".foundry", "tmp", "outputs", "reports"]
}
